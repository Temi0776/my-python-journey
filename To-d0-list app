def reminder_thread():
    while True:
        now = datetime.now()
        for task in tasks:
            if not task.completed and task.reminder_time <= now:
                print(f'Reminder: {task.title} is due at {task.deadline.strftime("%Y-%m-%d %H:%M")}')
                task.completed = True  # Mark as completed after reminder
        time.sleep(60)  # Check every minute
def main():
    check_password()
    load_tasks()

    thread = threading.Thread(target=reminder_thread, daemon=True)
    thread.start()

    while True:
        print('===TO-DO MENU===')
        print('1. Add Task')
        print('2. List Tasks')
        print('3. Edit Task')
        print('4. Mark Task as Complete')
        print('5. Save & Exit')

        choice = input('Choose an option: ')

        if choice == '1':
            add_task()
        elif choice == '2':
            list_tasks()
        elif choice == '3':
            edit_task()
        elif choice == '4':
            mark_complete()
        elif choice == '5':
            save_tasks()
            print('Tasks saved. Exiting...')
            break
        else:
            print('Invalid option. Please try again.\n')
if __name__ == '__main__':
    main()